        "name": "mode",
        "in": "query",
        "required": true,
        "description": "Command to execute.",
        "schema": {
          "type": "string",
          "enum": [
            "addlocalfile",
            "addurl",
            "auth",
            "change_cat",
            "change_opts",
            "change_script",
