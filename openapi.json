      "Archive": {
        "name": "archive",
        "in": "query",
        "required": false,
        "description": "Display history (default) or archived items",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "Cat": {
        "name": "cat",
        "in": "query",
        "required": false,
        "description": "Only return jobs with the specified category or categories (separated by a comma) Use * for Default",
        "schema": {
          "type": "string"
        }
      },
      "Category": {
        "name": "category",
        "in": "query",
        "required": false,
        "description": "Only return jobs with the specified category or categories (separated by a comma) Use * for Default",
        "schema": {
          "type": "string"
        }
      },
      "Connections": {
        "name": "connections",
        "in": "query",
        "required": false,
        "description": "SABnzbd connections query parameter.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        }
      },
      "DelFiles": {
        "name": "del_files",
        "in": "query",
        "required": false,
        "description": "SABnzbd del_files query parameter.",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "Dir": {
        "name": "dir",
        "in": "query",
        "required": false,
        "description": "SABnzbd dir query parameter.",
        "schema": {
          "type": "string"
        }
      },
      "Enable": {
        "name": "enable",
        "in": "query",
        "required": false,
        "description": "SABnzbd enable query parameter.",
        "schema": {
          "type": "string"
        }
      },
      "FailedOnly": {
        "name": "failed_only",
        "in": "query",
        "required": false,
        "description": "Only show failed jobs (shorthand for status=Failed)",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "Keyword": {
        "name": "keyword",
        "in": "query",
        "required": false,
        "description": "SABnzbd keyword query parameter.",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": "form",
        "explode": true
      },
      "LastHistoryUpdate": {
        "name": "last_history_update",
        "in": "query",
        "required": false,
        "description": "Only return full output if anything has changed since last_history_update, the last update is given by a previous call to history",
        "schema": {
          "type": "integer",
          "format": "int64"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Number of jobs to display",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 0
        }
      },
      "Name": {
        "name": "name",
        "in": "query",
        "required": false,
        "description": "URL-encoded version of the link to the NZB to be fetched.",
        "schema": {
          "type": "string"
        }
      },
      "Nzbname": {
        "name": "nzbname",
        "in": "query",
        "required": false,
        "description": "Name of the job, if empty the NZB filename is used.",
        "schema": {
          "type": "string"
        }
      },
      "NzfIds": {
        "name": "nzf_ids",
        "in": "query",
        "required": false,
        "description": "SABnzbd nzf_ids query parameter.",
        "schema": {
          "type": "string"
        }
      },
      "NzoIds": {
        "name": "nzo_ids",
        "in": "query",
        "required": false,
        "description": "Only return jobs with these nzo_ids (separated by a comma)",
        "schema": {
          "type": "string"
        }
      },
      "Output": {
        "name": "output",
        "in": "query",
        "required": false,
        "description": "Response format.",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "xml"
          ],
          "default": "json"
        }
      },
      "Password": {
        "name": "password",
        "in": "query",
        "required": false,
        "description": "Password to use when unpacking the job.",
        "schema": {
          "type": "string"
        }
      },
      "Pp": {
        "name": "pp",
        "in": "query",
        "required": false,
        "description": "Post-processing options: -1 = Default (of category) 0 = None 1 = \u002BRepair 2 = \u002BRepair/Unpack 3 = \u002BRepair/Unpack/Delete",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": -1,
          "maximum": 3
        }
      },
      "Priority": {
        "name": "priority",
        "in": "query",
        "required": false,
